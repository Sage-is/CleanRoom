# Native engine when `open` names none: ghidra, hopper, ida or builtin; blank means automatic order
CLEANROOM_ENGINE=
# Ghidra install root, the folder holding ghidraRun and support/ (brew install --cask ghidra)
GHIDRA_INSTALL_DIR=
# JDK 21 for Ghidra; the Mac default java is Oracle 8 x86_64 and does not work
JAVA_HOME=/opt/homebrew/opt/openjdk@21
# IDA Pro 9 install root, used only when engine=ida (idalib)
IDADIR=
# Comma-separated engines the tests must find; a missing one fails instead of skipping (make test_engines)
CLEANROOM_REQUIRE_ENGINES=
